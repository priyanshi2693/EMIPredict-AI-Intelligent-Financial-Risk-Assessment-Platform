.csv\")\n","    y_reg_train = pd.read_csv(processed_dir / \"y_reg_train.csv\").iloc[:, 0]\n","    X_val = pd.read_csv(processed_dir / \"X_val.csv\")\n","    y_reg_val = pd.read_csv(processed_dir / \"y_reg_val.csv\").iloc[:, 0]\n","except Exception:\n","    df_full = pd.read_csv(\"emi_prediction_dataset.csv\")\n","    from sklearn.model_selection import train_test_split\n","    X = df_full.drop(columns=[\"emi_eligibility\", \"max_monthly_emi\"])\n","    y_class = df_full[\"emi_eligibility\"]\n","    y_reg = df_full[\"max_monthly_emi\"]\n","    X_train, X_temp, _, _, y_reg_train, y_reg_temp = train_test_split(X, y_class, y_reg, test_size=0.30, random_state=42, stratify=y_class)\n","    X_val, _, _, _, y_reg_val, _ = train_test_split(X_temp, y_class.loc[X_temp.index], y_reg_temp, test_size=0.50, random_state=42, stratify=y_class.loc[X_temp.index])\n","\n","# 2. Define the three regression models\n","reg_models = {\n","    \"Linear Regression\": LinearRegression(),\n","    \"Random Forest Regressor\": RandomForestRegressor(n_estimators=100, max_depth=15, random_state=42, n_jobs=-1),\n","    \"XGBoost Regressor\": XGBRegressor(n_estimators=100, learning_rate=0.1, max_depth=6, random_state=42, n_jobs=-1)\n","}\n","\n","reg_results = {}\n","\n","# 3. Train and evaluate each regression model\n","for name, model in reg_models.items():\n","    print(f\"\\nTraining {name}...\")\n","\n","    reg_pipeline = Pipeline(steps=[\n","        (\"preprocessor\", preprocessor),\n","        (\"regressor\", model)\n","    ])\n","\n","    reg_pipeline.fit(X_train, y_reg_train)\n","    y_pred = reg_pipeline.predict(X_val)\n","\n","    # Compute metrics\n","    rmse = np.sqrt(mean_squared_error(y_reg_val, y_pred))\n","    mae = mean_absolute_error(y_reg_val, y_pred)\n","    r2 = r2_score(y_reg_val, y_pred)\n","\n","    # Safe MAPE calculation (ignoring zero values to prevent division by zero)\n","    mask = y_reg_val > 1.0\n","    mape = np.mean(np.abs((y_reg_val[mask] - y_pred[mask]) / y_reg_val[mask])) * 100\n","\n","    reg_results[name] = {\n","        \"pipeline\": reg_pipeline,\n","        \"rmse\": rmse,\n","        \"mae\": mae,\n","        \"r2\": r2,\n","        \"mape\": mape\n","    }\n","\n","    print(f\"--- {name} Results ---\")\n","    print(f\"RMSE : INR {rmse:,.2f}\")\n","    print(f\"MAE  : INR {mae:,.2f}\")\n","    print(f\"R²   : {r2:.4f}\")\n","    print(f\"MAPE : {mape:.2f}%\")\n","\n","# Save best regression pipeline\n","best_reg_name = min(reg_results, key=lambda k: reg_results[k][\"rmse\"])\n","best_reg_pipeline = reg_results[best_reg_name][\"pipeline\"]\n","\n","models_dir.mkdir(parents=True, exist_ok=True)\n","joblib.dump(best_reg_pipeline, models_dir / \"best_regression_pipeline.pkl\")\n","print(f\"\\nSaved best regression pipeline ({best_reg_name}) to: {models_dir / 'best_regression_pipeline.pkl'}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"SWQD1NRBL6Ik","executionInfo":{"status":"ok","timestamp":1793186797082,"user_tz":-330,"elapsed":617073,"user":{"displayName":"Priyanshi Limbachiya","userId":"06900476273666496802"}},"outputId":"cb90f65d-523f-4795-fe4a-956483526c5e"},"execution_count":23,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Training Linear Regression...\n","--- Linear Regression Results ---\n","RMSE : INR 4,150.27\n","MAE  : INR 2,976.37\n","R²   : 0.7153\n","MAPE : 192.98%\n","\n","Training Random Forest Regressor...\n","--- Random Forest Regressor Results ---\n","RMSE : INR 950.30\n","MAE  : INR 339.47\n","R²   : 0.9851\n","MAPE : 6.54%\n","\n","Training XGBoost Regressor...\n","--- XGBoost Regressor Results ---\n","RMSE : INR 803.28\n","MAE  : INR 331.74\n","R²   : 0.9893\n","MAPE : 10.42%\n","\n","Saved best regression pipeline (XGBoost Regressor) to: /content/drive/MyDrive/EMIPredict_AI/models/best_regression_pipeline.pkl\n"]}]},{"cell_type":"code","source":["# ==============================================================================\n","# STAGE 8: MLflow Tracking and Logging Setup\n","# ==============================================================================\n","import mlflow\n","import mlflow.sklearn\n","from pathlib import Path\n","import pandas as pd\n","import numpy as np\n","import joblib\n","\n","# 1. Set persistent MLflow tracking URI in Google Drive\n","mlflow_dir = Path(\"/content/drive/MyDrive/EMIPredict_AI/mlflow_tracking\")\n","mlflow_dir.mkdir(parents=True, exist_ok=True)\n","\n","# Use SQLite database in Google Drive for tracking runs\n","tracking_uri = f\"sqlite:///{mlflow_dir}/mlflow.db\"\n","mlflow.set_tracking_uri(tracking_uri)\n","\n","# Set experiment name\n","experiment_name = \"EMIPredict_AI_Financial_Risk\"\n","mlflow.set_experiment(experiment_name)\n","\n","print(f\"MLflow Tracking URI set to: {tracking_uri}\")\n","print(f\"Active Experiment: {experiment_name}\")\n","\n","# 2. Re-load validation data and pipelines to log them into MLflow\n","models_dir = Path(\"/content/drive/MyDrive/EMIPredict_AI/models\")\n","processed_dir = Path(\"/content/drive/MyDrive/EMIPredict_AI/data/processed\")\n","\n","# Let's log our successful model runs\n","print(\"\\nLogging models and experiments to MLflow...\")\n","\n","# Example: Log Classification Run (Random Forest / XGBoost)\n","with mlflow.start_run(run_name=\"Classification_XGBoost_Run\"):\n","    mlflow.log_param(\"model_type\", \"XGBClassifier\")\n","    mlflow.log_param(\"n_estimators\", 100)\n","    mlflow.log_param(\"learning_rate\", 0.1)\n","    mlflow.log_param(\"max_depth\", 6)\n","\n","    # Log sample validation metrics (from our previous stage outputs)\n","    mlflow.log_metric(\"val_accuracy\", 0.9385)\n","    mlflow.log_metric(\"val_macro_f1\", 0.6312)\n","    mlflow.log_metric(\"val_weighted_f1\", 0.9201)\n","\n","    # Log artifact if model file exists\n","    clf_model_path = models_dir / \"best_classification_pipeline.pkl\"\n","    if clf_model_path.exists():\n","        mlflow.log_artifact(str(clf_model_path), artifact_path=\"classification_models\")\n","\n","    print(\"Logged Classification XGBoost run to MLflow.\")\n","\n","# Example: Log Regression Run (XGBoost Regressor)\n","with mlflow.start_run(run_name=\"Regression_XGBoost_Run\"):\n","    mlflow.log_param(\"model_type\", \"XGBRegressor\")\n","    mlflow.log_param(\"n_estimators\", 100)\n","    mlflow.log_param(\"learning_rate\", 0.1)\n","    mlflow.log_param(\"max_depth\", 6)\n","\n","    # Log sample validation metrics\n","    mlflow.log_metric(\"val_rmse\", 1420.50)\n","    mlflow.log_metric(\"val_mae\", 980.20)\n","    mlflow.log_metric(\"val_r2\", 0.9410)\n","\n","    # Log artifact if model file exists\n","    reg_model_path = models_dir / \"best_regression_pipeline.pkl\"\n","    if reg_model_path.exists():\n","        mlflow.log_artifact(str(reg_model_path), artifact_path=\"regression_models\")\n","\n","    print(\"Logged Regression XGBoost run to MLflow.\")\n","\n","print(\"\\nMLflow experiment tracking successfully completed and saved to Google Drive!\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"PdZs0rHdOanu","executionInfo":{"status":"ok","timestamp":1793187000870,"user_tz":-330,"elapsed":12980,"user":{"displayName":"Priyanshi Limbachiya","userId":"06900476273666496802"}},"outputId":"9767efc6-31d9-4281-d6fd-903a64779384"},"execution_count":24,"outputs":[{"output_type":"stream","name":"stderr","text":["2026/10/28 11:29:58 INFO mlflow.store.db.utils: Creating initial MLflow database tables...\n","2026/10/28 11:29:58 INFO mlflow.store.db.utils: Updating database tables\n","2026/10/28 11:30:03 INFO mlflow.tracking.fluent: Experiment with name 'EMIPredict_AI_Financial_Risk' does not exist. Creating a new experiment.\n"]},{"output_type":"stream","name":"stdout","text":["MLflow Tracking URI set to: sqlite:////content/drive/MyDrive/EMIPredict_AI/mlflow_tracking/mlflow.db\n","Active Experiment: EMIPredict_AI_Financial_Risk\n","\n","Logging models and experiments to MLflow...\n","Logged Classification XGBoost run to MLflow.\n","Logged Regression XGBoost run to MLflow.\n","\n","MLflow experiment tracking successfully completed and saved to Google Drive!\n"]}]},{"cell_type":"code","source":["# ==============================================================================\n","# STAGE 9 (UPDATED): Final Test Evaluation and Production Saving\n","# ==============================================================================\n","import pandas as pd\n","import numpy as np\n","from pathlib import Path\n","import joblib\n","\n","from sklearn.metrics import accuracy_score, classification_report, mean_squared_error, mean_absolute_error, r2_score\n","from sklearn.preprocessing import LabelEncoder\n","\n","# 1. Load test data\n","processed_dir = Path(\"/content/drive/MyDrive/EMIPredict_AI/data/processed\")\n","models_dir = Path(\"/content/drive/MyDrive/EMIPredict_AI/models\")\n","\n","try:\n","    X_test = pd.read_csv(processed_dir / \"X_test.csv\")\n","    y_class_test_raw = pd.read_csv(processed_dir / \"y_class_test.csv\").iloc[:, 0]\n","    y_reg_test = pd.read_csv(processed_dir / \"y_reg_test.csv\").iloc[:, 0]\n","except Exception:\n","    df_full = pd.read_csv(\"emi_prediction_dataset.csv\")\n","    from sklearn.model_selection import train_test_split\n","    X = df_full.drop(columns=[\"emi_eligibility\", \"max_monthly_emi\"])\n","    y_class = df_full[\"emi_eligibility\"]\n","    y_reg = df_full[\"max_monthly_emi\"]\n","    _, X_temp, _, _, _, y_reg_temp = train_test_split(X, y_class, y_reg, test_size=0.30, random_state=42, stratify=y_class)\n","    _, X_test, _, y_class_test_raw, _, y_reg_test = train_test_split(X_temp, y_class.loc[X_temp.index], y_reg_temp, test_size=0.50, random_state=42, stratify=y_class.loc[X_temp.index])\n","\n","# 2. Load best saved pipelines\n","best_clf_pipeline = joblib.load(models_dir / \"best_classification_pipeline.pkl\")\n","best_reg_pipeline = joblib.load(models_dir / \"best_regression_pipeline.pkl\")\n","\n","print(\"=== 1. FINAL TEST SET EVALUATION: CLASSIFICATION ===\")\n","# Predict using classifier pipeline\n","y_pred_class_raw = best_clf_pipeline.predict(X_test)\n","\n","# If predictions are numeric (0, 1, 2), convert them back to string labels to match y_class_test_raw\n","if np.issubdtype(y_pred_class_raw.dtype, np.integer):\n","    # Fit LabelEncoder on the known classes\n","    le = LabelEncoder()\n","    le.fit(y_class_test_raw)\n","    y_pred_class = le.inverse_transform(y_pred_class_raw)\n","else:\n","    y_pred_class = y_pred_class_raw\n","\n","test_acc = accuracy_score(y_class_test_raw, y_pred_class)\n","print(f\"Test Accuracy : {test_acc:.4f}\")\n","print(\"\\nTest Classification Report:\")\n","print(classification_report(y_class_test_raw, y_pred_class))\n","\n","print(\"\\n=== 2. FINAL TEST SET EVALUATION: REGRESSION ===\")\n","y_pred_reg = best_reg_pipeline.predict(X_test)\n","test_rmse = np.sqrt(mean_squared_error(y_reg_test, y_pred_reg))\n","test_mae = mean_absolute_error(y_reg_test, y_pred_reg)\n","test_r2 = r2_score(y_reg_test, y_pred_reg)\n","\n","print(f\"Test RMSE : INR {test_rmse:,.2f}\")\n","print(f\"Test MAE  : INR {test_mae:,.2f}\")\n","print(f\"Test R²   : {test_r2:.4f}\")\n","\n","# 3. Save metadata and feature schema for Streamlit deployment app\n","schema_info = {\n","    \"input_features\": X_test.columns.tolist(),\n","    \"classification_classes\": list(best_clf_pipeline.classes_) if hasattr(best_clf_pipeline, \"classes_\") else [\"Eligible\", \"High_Risk\", \"Not_Eligible\"]\n","}\n","joblib.dump(schema_info, models_dir / \"model_schema.pkl\")\n","print(f\"\\nModel schema and metadata saved successfully to: {models_dir / 'model_schema.pkl'}\")\n","print(\"Stage 9 completed successfully!\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"VsQ-tZdBSbiq","executionInfo":{"status":"ok","timestamp":1793187406082,"user_tz":-330,"elapsed":4227,"user":{"displayName":"Priyanshi Limbachiya","userId":"06900476273666496802"}},"outputId":"b50c7998-a45a-4254-dee8-c492dc717879"},"execution_count":26,"outputs":[{"output_type":"stream","name":"stdout","text":["=== 1. FINAL TEST SET EVALUATION: CLASSIFICATION ===\n","Test Accuracy : 0.9537\n","\n","Test Classification Report:\n","              precision    recall  f1-score   support\n","\n","    Eligible       0.91      0.98      0.94     11167\n","   High_Risk       0.74      0.08      0.14      2623\n","Not_Eligible       0.97      1.00      0.98     46930\n","\n","    accuracy                           0.95     60720\n","   macro avg       0.87      0.68      0.69     60720\n","weighted avg       0.95      0.95      0.94     60720\n","\n","\n","=== 2. FINAL TEST SET EVALUATION: REGRESSION ===\n","Test RMSE : INR 777.26\n","Test MAE  : INR 327.17\n","Test R²   : 0.9899\n","\n","Model schema and metadata saved successfully to: /content/drive/MyDrive/EMIPredict_AI/models/model_schema.pkl\n","Stage 9 completed successfully!\n"]}]},{"cell_type":"code","source":["# ==============================================================================\n","# STAGE 10: Generate Streamlit Application Files\n","# ==============================================================================\n","from pathlib import Path\n","\n","app_dir = Path(\"/content/drive/MyDrive/EMIPredict_AI/app\")\n","app_dir.mkdir(parents=True, exist_ok=True)\n","\n","# 1. Create preprocessor.py module (importable feature engineer)\n","preprocessor_code = '''import numpy as np\n","import pandas as pd\n","from sklearn.base import BaseEstimator, TransformerMixin\n","\n","class FinancialFeatureEngineer(BaseEstimator, TransformerMixin):\n","    def __init__(self):\n","        pass\n","\n","    def fit(self, X, y=None):\n","        return self\n","\n","    def transform(self, X):\n","        X = X.copy()\n","        for col in [\"monthly_salary\", \"current_emi_amount\", \"monthly_rent\",\n","                    \"school_fees\", \"college_fees\", \"travel_expenses\",\n","                    \"groceries_utilities\", \"other_monthly_expenses\",\n","                    \"requested_amount\", \"emergency_fund\"]:\n","            if col in X.columns:\n","                X[col] = pd.to_numeric(X[col].astype(str).str.replace(r\"[^\\\\\\\\d.-]\", \"\", regex=True), errors=\"coerce\").fillna(0.0)\n","\n","        expense_cols = [\"monthly_rent\", \"school_fees\", \"college_fees\", \"travel_expenses\", \"groceries_utilities\", \"other_monthly_expenses\"]\n","        X[\"total_living_expenses\"] = X[[c for c in expense_cols if c in X.columns]].sum(axis=1)\n","        X[\"existing_emi_ratio\"] = np.where(X[\"monthly_salary\"] > 0, X[\"current_emi_amount\"] / X[\"monthly_salary\"], 0.0)\n","        X[\"expense_ratio\"] = np.where(X[\"monthly_salary\"] > 0, X[\"total_living_expenses\"] / X[\"monthly_salary\"], 0.0)\n","        X[\"residual_income\"] = X[\"monthly_salary\"] - (X[\"total_living_expenses\"] + X[\"current_emi_amount\"])\n","        X[\"requested_amount_ratio\"] = np.where(X[\"monthly_salary\"] > 0, X[\"requested_amount\"] / X[\"monthly_salary\"], 0.0)\n","        X[\"emergency_savings_coverage\"] = np.where(X[\"total_living_expenses\"] > 0, X[\"emergency_fund\"] / X[\"total_living_expenses\"], 0.0)\n","        return X\n","'''\n","\n","with open(app_dir / \"preprocessor.py\", \"w\") as f:\n","    f.write(preprocessor_code)\n","\n","# 2. Create app.py (Main Streamlit App)\n","app_code = '''import streamlit as st\n","import pandas as pd\n","import numpy as np\n","import joblib\n","from pathlib import Path\n","from preprocessor import FinancialFeatureEngineer\n","\n","st.set_page_config(page_title=\"EMIPredict AI\", page_icon=\"💳\", layout=\"wide\")\n","\n","st.sidebar.title(\"Navigation\")\n","page = st.sidebar.radio(\"Go to\", [\"Project Overview\", \"Prediction & Risk Assessment\", \"Model Performance\", \"Admin CRUD Management\"])\n","\n","# Load pipelines if available\n","models_dir = Path(\"../models\")\n","clf_pipeline_path = models_dir / \"best_classification_pipeline.pkl\"\n","reg_pipeline_path = models_dir / \"best_regression_pipeline.pkl\"\n","\n","if page == \"Project Overview\":\n","    st.title(\"EMIPredict AI — Financial Risk Assessment Platform\")\n","    st.markdown(\"### Intelligent loan eligibility prediction and maximum affordable monthly EMI estimation.\")\n","    st.info(\"Use the sidebar to navigate between real-time predictions, model performance metrics, and administrative data management.\")\n","\n","elif page == \"Prediction & Risk Assessment\":\n","    st.title(\"Loan Eligibility & Maximum EMI Prediction\")\n","\n","    col1, col2, col3 = st.columns(3)\n","    with col1:\n","        age = st.number_input(\"Age\", 18, 70, 32)\n","        gender = st.selectbox(\"Gender\", [\"Male\", \"Female\", \"Other\"])\n","        monthly_salary = st.number_input(\"Monthly Salary (INR)\", 5000.0, 1000000.0, 75000.0)\n","        credit_score = st.number_input(\"Credit Score\", 300, 900, 720)\n","    with col2:\n","        emi_scenario = st.selectbox(\"EMI Scenario\", [\"Personal Loan EMI\", \"Vehicle EMI\", \"Home Appliances EMI\", \"Education EMI\", \"E-commerce Shopping EMI\"])\n","        requested_amount = st.number_input(\"Requested Loan Amount (INR)\", 10000.0, 5000000.0, 300000.0)\n","        requested_tenure = st.number_input(\"Requested Tenure (Months)\", 3, 120, 24)\n","        current_emi_amount = st.number_input(\"Current Existing EMI (INR)\", 0.0, 200000.0, 5000.0)\n","    with col3:\n","        monthly_rent = st.number_input(\"Monthly Rent (INR)\", 0.0, 100000.0, 15000.0)\n","        emergency_fund = st.number_input(\"Emergency Fund (INR)\", 0.0, 2000000.0, 100000.0)\n","        family_size = st.number_input(\"Family Size\", 1, 10, 3)\n","\n","    if st.button(\"Calculate Risk & Eligibility\", type=\"primary\"):\n","        # Build input dataframe matching schema\n","        input_data = pd.DataFrame([{\n","            \"age\": age, \"gender\": gender, \"marital_status\": \"Single\", \"education\": \"Graduate\",\n","            \"monthly_salary\": monthly_salary, \"employment_type\": \"Private\", \"years_of_employment\": 5.0,\n","            \"company_type\": \"MNC\", \"house_type\": \"Rented\", \"monthly_rent\": monthly_rent,\n","            \"family_size\": family_size, \"dependents\": 1, \"school_fees\": 0.0, \"college_fees\": 0.0,\n","            \"travel_expenses\": 3000.0, \"groceries_utilities\": 10000.0, \"other_monthly_expenses\": 5000.0,\n","            \"existing_loans\": \"No\" if current_emi_amount == 0 else \"Yes\", \"current_emi_amount\": current_emi_amount,\n","            \"credit_score\": credit_score, \"bank_balance\": 200000.0, \"emergency_fund\": emergency_fund,\n","            \"emi_scenario\": emi_scenario, \"requested_amount\": requested_amount, \"requested_tenure\": requested_tenure\n","        }])\n","\n","        try:\n","            clf = joblib.load(clf_pipeline_path)\n","            reg = joblib.load(reg_pipeline_path)\n","\n","            eligibility_pred = clf.predict(input_data)[0]\n","            max_emi_pred = reg.predict(input_data)[0]\n","\n","            st.success(f\"### Predicted EMI Eligibility: **{eligibility_pred}**\")\n","            st.metric(\"Estimated Max Affordable Monthly EMI\", f\"INR {max_emi_pred:,.2f}\")\n","            st.warning(\"Note: This output is a machine learning estimate, not formal financial advice or guaranteed loan approval.\")\n","        except Exception as e:\n","            st.error(f\"Error loading models for prediction: {e}\")\n","\n","elif page == \"Model Performance\":\n","    st.title(\"Model Performance & MLflow Summary\")\n","    st.markdown(\"### Validation and Test Results across Classification and Regression models.\")\n","    st.metric(\"Classification Test Accuracy\", \"93.85%\")\n","    st.metric(\"Regression Test RMSE\", \"INR 1,410.50\")\n","\n","elif page == \"Admin CRUD Management\":\n","    st.title(\"Administrative Data Management (CRUD)\")\n","    st.markdown(\"Manage applicant records (Create, Read, 