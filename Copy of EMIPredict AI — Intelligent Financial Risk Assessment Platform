gression(max_iter=1000, random_state=42),\n","    \"Random Forest\": RandomForestClassifier(n_estimators=100, max_depth=15, random_state=42, n_jobs=-1),\n","    \"XGBoost\": XGBClassifier(n_estimators=100, learning_rate=0.1, max_depth=6, random_state=42, n_jobs=-1, eval_metric=\"mlogloss\")\n","}\n","\n","results = {}\n","\n","# 5. Train and evaluate each model\n","for name, model in models.items():\n","    print(f\"\\nTraining {name}...\")\n","\n","    # Create full pipeline: Preprocessing + Classifier\n","    clf_pipeline = Pipeline(steps=[\n","        (\"preprocessor\", preprocessor),\n","        (\"classifier\", model)\n","    ])\n","\n","    # Fit model on training data\n","    clf_pipeline.fit(X_train, y_train)\n","\n","    # Predict numeric classes on validation data\n","    y_pred_encoded = clf_pipeline.predict(X_val)\n","\n","    # Convert predictions back to original string labels for readable evaluation\n","    y_pred = label_encoder.inverse_transform(y_pred_encoded)\n","\n","    # Compute metrics against original string labels\n","    acc = accuracy_score(y_val_raw, y_pred)\n","    macro_f1 = f1_score(y_val_raw, y_pred, average=\"macro\")\n","    weighted_f1 = f1_score(y_val_raw, y_pred, average=\"weighted\")\n","\n","    results[name] = {\n","        \"pipeline\": clf_pipeline,\n","        \"accuracy\": acc,\n","        \"macro_f1\": macro_f1,\n","        \"weighted_f1\": weighted_f1\n","    }\n","\n","    print(f\"--- {name} Results ---\")\n","    print(f\"Accuracy   : {acc:.4f}\")\n","    print(f\"Macro F1   : {macro_f1:.4f}\")\n","    print(f\"Weighted F1: {weighted_f1:.4f}\")\n","    print(\"\\nClassification Report:\")\n","    print(classification_report(y_val_raw, y_pred))\n","\n","# Save the best classification pipeline (e.g. XGBoost or Random Forest)\n","best_clf_name = max(results, key=lambda k: results[k][\"weighted_f1\"])\n","best_clf_pipeline = results[best_clf_name][\"pipeline\"]\n","joblib.dump(best_clf_pipeline, models_dir / \"best_classification_pipeline.pkl\")\n","print(f\"\\nSaved best classification pipeline ({best_clf_name}) to: {models_dir / 'best_classification_pipeline.pkl'}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"qBARF1EJLBZf","executionInfo":{"status":"ok","timestamp":1793185689207,"user_tz":-330,"elapsed":166555,"user":{"displayName":"Priyanshi Limbachiya","userId":"06900476273666496802"}},"outputId":"33e6cf13-192e-451f-ff34-899ed3043b63"},"execution_count":22,"outputs":[{"output_type":"stream","name":"stdout","text":["Class mapping: {'Eligible': 0, 'High_Risk': 1, 'Not_Eligible': 2}\n","\n","Training Logistic Regression...\n","--- Logistic Regression Results ---\n","Accuracy   : 0.8970\n","Macro F1   : 0.5828\n","Weighted F1: 0.8776\n","\n","Classification Report:\n","              precision    recall  f1-score   support\n","\n","    Eligible       0.78      0.81      0.80     11166\n","   High_Risk       0.15      0.00      0.01      2623\n","Not_Eligible       0.92      0.97      0.95     46931\n","\n","    accuracy                           0.90     60720\n","   macro avg       0.62      0.59      0.58     60720\n","weighted avg       0.86      0.90      0.88     60720\n","\n","\n","Training Random Forest...\n","--- Random Forest Results ---\n","Accuracy   : 0.9369\n","Macro F1   : 0.6262\n","Weighted F1: 0.9162\n","\n","Classification Report:\n","              precision    recall  f1-score   support\n","\n","    Eligible       0.89      0.92      0.91     11166\n","   High_Risk       0.50      0.00      0.00      2623\n","Not_Eligible       0.95      0.99      0.97     46931\n","\n","    accuracy                           0.94     60720\n","   macro avg       0.78      0.64      0.63     60720\n","weighted avg       0.92      0.94      0.92     60720\n","\n","\n","Training XGBoost...\n","--- XGBoost Results ---\n","Accuracy   : 0.9538\n","Macro F1   : 0.6855\n","Weighted F1: 0.9376\n","\n","Classification Report:\n","              precision    recall  f1