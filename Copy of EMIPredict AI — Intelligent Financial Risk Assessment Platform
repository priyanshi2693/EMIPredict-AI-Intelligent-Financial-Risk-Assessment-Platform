f[\"emi_scenario\"].value_counts().index, ax=axes[0], palette=\"Set2\")\n","axes[0].set_title(\"Eligibility Breakdown by EMI Scenario\")\n","axes[0].set_xlabel(\"Applicant Count\")\n","axes[0].set_ylabel(\"EMI Scenario\")\n","axes[0].legend(title=\"Eligibility\")\n","\n","# 2. Credit Score vs Monthly Salary colored by Eligibility\n","# Clean numeric columns if loaded from local df\n","eda_df[\"monthly_salary\"] = pd.to_numeric(eda_df[\"monthly_salary\"].astype(str).str.replace(r\"[^\\d.-]\", \"\", regex=True), errors=\"coerce\")\n","\n","sns.scatterplot(data=eda_df.sample(5000, random_state=42), x=\"monthly_salary\", y=\"credit_score\", hue=\"emi_eligibility\", alpha=0.6, ax=axes[1], palette=\"viridis\")\n","axes[1].set_title(\"Credit Score vs Monthly Salary (Sampled)\")\n","axes[1].set_xlabel(\"Monthly Salary (INR)\")\n","axes[1].set_ylabel(\"Credit Score\")\n","axes[1].legend(title=\"Eligibility\", loc=\"lower right\")\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":393},"id":"FG0fFeg8Iz7l","executionInfo":{"status":"ok","timestamp":1793184772808,"user_tz":-330,"elapsed":3177,"user":{"displayName":"Priyanshi Limbachiya","userId":"06900476273666496802"}},"outputId":"cae2f04f-7ce3-4248-bec0-68cdfff0599e"},"execution_count":18,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["## Stage 5: Feature Engineering and Reusable Preprocessing Pipelines\n","# ==============================================================================\n","# STAGE 5, CELL 1: Custom Feature Engineering Transformer\n","# ==============================================================================\n","import numpy as np\n","import pandas as pd\n","from sklearn.base import BaseEstimator, TransformerMixin\n","\n","class FinancialFeatureEngineer(BaseEstimator, TransformerMixin):\n","    def __init__(self):\n","        pass\n","\n","    def fit(self, X, y=None):\n","        return self\n","\n","    def transform(self, X):\n","        X = X.copy()\n","\n","        # Ensure numeric conversion for key columns\n","        for col in [\"monthly_salary\", \"current_emi_amount\", \"monthly_rent\",\n","                    \"school_fees\", \"college_fees\", \"travel_expenses\",\n","                    \"groceries_utilities\", \"other_monthly_expenses\",\n","                    \"requested_amount\", \"emergency_fund\"]:\n","            if col in X.columns:\n","                X[col] = pd.to_numeric(X[col].astype(str).str.replace(r\"[^\\d.-]\", \"\", regex=True), errors=\"coerce\").fillna(0.0)\n","\n","        # 1. Total Living Expenses\n","        expense_cols = [\"monthly_rent\", \"school_fees\", \"college_fees\", \"travel_expenses\", \"groceries_utilities\", \"other_monthly_expenses\"]\n","        X[\"total_living_expenses\"] = X[[c for c in expense_cols if c in X.columns]].sum(axis=1)\n","\n","        # 2. Existing EMI-to-Income Ratio (Debt-to-Income)\n","        X[\"existing_emi_ratio\"] = np.where(X[\"monthly_salary\"] > 0, X[\"current_emi_amount\"] / X[\"monthly_salary\"], 0.0)\n","\n","        # 3. Expense-to-Income Ratio\n","        X[\"expense_ratio\"] = np.where(X[\"monthly_salary\"] > 0, X[\"total_living_expenses\"] / X[\"monthly_salary\"], 0.0)\n","\n","        # 4. Residual Disposable Income\n","        X[\"residual_income\"] = X[\"monthly_salary\"] - (X[\"total_living_expenses\"] + X[\"current_emi_amount\"])\n","\n","        # 5. Requested Amount-to-Income Ratio\n","        X[\"requested_amount_ratio\"] = np.where(X[\"monthly_salary\"] > 0, X[\"requested_amount\"] / X[\"monthly_salary\"], 0.0)\n","\n","        # 6. Emergency Savings Coverage (Months of living expenses saved)\n","        X[\"emergency_savings_coverage\"] = np.where(X[\"total_living_expenses\"] > 0, X[\"emergency_fund\"] / X[\"total_living_expenses\"], 0.0)\n","\n","        return X\n","\n","print(\"FinancialFeatureEngineer class defined successfully!\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"RyQ66zG5JCS2","executionInfo":{"status":"ok","timestamp":1793184984677,"user_tz":-330,"elapsed":16,"user":{"displayName":"Priyanshi Limbachiya","userId":"06900476273666496802"}},"outputId":"c15dc6dc-79d0-4577-c932-2839a60cf6a1"},"execution_count":19,"outputs":[{"output_type":"stream","name":"stdout","text":["FinancialFeatureEngineer class defined successfully!\n"]}]},{"cell_type":"code","source":["# ==============================================================================\n","# STAGE 5, CELL 2: Reusable Preprocessing Pipeline Construction\n","# ==============================================================================\n","from sklearn.pipeline import Pipeline\n","from sklearn.compose import ColumnTransformer\n","from sklearn.impute import SimpleImputer\n","from sklearn.preprocessing import StandardScaler, OneHotEncoder\n","import joblib\n","from pathlib import Path\n","\n","# Load training features\n","train_path = Path(\"/content/drive/MyDrive/EMIPredict_AI/data/processed/X_train.csv\")\n","if train_path.exists():\n","    X_train = pd.read_csv(train_path)\n","else:\n","    # Local fallback\n","    df_local = pd.read_csv(\"emi_prediction_dataset.csv\")\n","    X_train = df_local.drop(columns=[\"emi_eligibility\", \"max_monthly_emi\"])\n","\n","# Apply feature engineering first to get full feature set\n","fe = FinancialFeatureEngineer()\n","X_train_fe = fe.fit_transform(X_train)\n","\n","# Identify numeric and categorical columns after feature engineering\n","numeric_features = X_train_fe.select_dtypes(include=[\"int64\", \"float64\"]).columns.tolist()\n","categorical_features = X_train_fe.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\n","\n","# Define preprocessing for numeric data (median imputation + standard scaling)\n","numeric_transformer = Pipeline(steps=[\n","    (\"imputer\", SimpleImputer(strategy=\"median\")),\n","    (\"scaler\", StandardScaler())\n","])\n","\n","# Define preprocessing for categorical data (most frequent imputation + one-hot encoding handling unknown categories)\n","categorical_transformer = Pipeline(steps=[\n","    (\"imputer\", SimpleImputer(strategy=\"constant\", fill_value=\"Unknown\")),\n","    (\"onehot\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False))\n","])\n","\n","# Combine into a single ColumnTransformer\n","preprocessor = ColumnTransformer(transformers=[\n","    (\"num\", numeric_transformer, numeric_features),\n","    (\"cat\", categorical_transformer, categorical_features)\n","])\n","\n","# Combine feature engineering and preprocessing into one master pipeline\n","master_preprocessor = Pipeline(steps=[\n","    (\"feature_engineer\", FinancialFeatureEngineer()),\n","    (\"preprocessing\", preprocessor)\n","])\n","\n","# Fit on training data and test transformation\n","master_preprocessor.fit(X_train)\n","X_train_transformed = master_preprocessor.transform(X_train)\n","\n","print(f\"Original feature count : {X_train.shape[1]}\")\n","print(f\"Transformed feature matrix shape: {X_train_transformed.shape}\")\n","\n","# Save the preprocessor pipeline\n","models_dir = Path(\"/content/drive/MyDrive/EMIPredict_AI/models\")\n","models_dir.mkdir(parents=True, exist_ok=True)\n","pipeline_path = models_dir / \"master_preprocessor.pkl\"\n","joblib.dump(master_preprocessor, pipeline_path)\n","print(f\"Master preprocessing pipeline saved to: {pipeline_path}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"VxIZSjpLJ2yP","executionInfo":{"status":"ok","timestamp":1793185150978,"user_tz":-330,"elapsed":24280,"user":{"displayName":"Priyanshi Limbachiya","userId":"06900476273666496802"}},"outputId":"15d89bd3-317c-4a67-c1d0-359829e6f779"},"execution_count":20,"outputs":[{"output_type":"stream","name":"stdout","text":["Original feature count : 25\n","Transformed feature matrix shape: (283360, 52)\n","Master preprocessing pipeline sa